{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KonMin Launcher",
  "version": "2.9.0",
  "identifier": "com.konmin.launcher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "KonMin Launcher",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0F111700",
        "center": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": {
        "default-src": [
          "'self'"
        ],
        "script-src": [
          "'self'",
          "blob:"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "font-src": [
          "'self'",
          "data:"
        ],
        "img-src": [
          "'self'",
          "data:",
          "blob:",
          "https:",
          "asset:",
          "http://asset.localhost"
        ],
        "media-src": [
          "'self'",
          "data:",
          "blob:",
          "asset:",
          "http://asset.localhost",
          "https:"
        ],
        "connect-src": [
          "'self'",
          "data:",
          "blob:",
          "ipc:",
          "http://ipc.localhost",
          "asset:",
          "http://asset.localhost",
          "https://api.millida.net",
          "wss://api.millida.net",
          "https://api.modrinth.com",
          "https://cdn.modrinth.com",
          "https://millida.net"
        ],
        "worker-src": [
          "'self'",
          "blob:"
        ],
        "object-src": [
          "'none'"
        ],
        "base-uri": [
          "'self'"
        ],
        "form-action": [
          "'none'"
        ],
        "frame-src": [
          "https://www.youtube-nocookie.com",
          "https://w.soundcloud.com"
        ],
        "frame-ancestors": [
          "'none'"
        ]
      },
      "devCsp": {
        "default-src": [
          "'self'"
        ],
        "script-src": [
          "'self'",
          "'unsafe-inline'",
          "'unsafe-eval'",
          "http://localhost:5173",
          "http://127.0.0.1:5173",
          "blob:"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'",
          "http://localhost:5173",
          "http://127.0.0.1:5173"
        ],
        "font-src": [
          "'self'",
          "data:",
          "http://localhost:5173",
          "http://127.0.0.1:5173"
        ],
        "img-src": [
          "'self'",
          "data:",
          "blob:",
          "https:",
          "asset:",
          "http://asset.localhost",
          "http://127.0.0.1:5173"
        ],
        "media-src": [
          "'self'",
          "data:",
          "blob:",
          "asset:",
          "http://asset.localhost",
          "http://127.0.0.1:5173",
          "https:"
        ],
        "connect-src": [
          "'self'",
          "data:",
          "blob:",
          "ipc:",
          "http://ipc.localhost",
          "asset:",
          "http://asset.localhost",
          "ws://127.0.0.1:5173",
          "ws://localhost:5173",
          "http://127.0.0.1:5173",
          "http://localhost:5173",
          "https://api.millida.net",
          "wss://api.millida.net",
          "https://api.modrinth.com",
          "https://cdn.modrinth.com",
          "https://millida.net"
        ],
        "worker-src": [
          "'self'",
          "blob:"
        ],
        "object-src": [
          "'none'"
        ],
        "base-uri": [
          "'self'"
        ],
        "frame-src": [
          "https://www.youtube-nocookie.com",
          "https://w.soundcloud.com"
        ]
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "publisher": "KonMin",
    "copyright": "© 2026 KonMin. Based on Millida Launcher © 2026 Millida (Roman Babaskin). GPL-3.0-only",
    "category": "Game",
    "shortDescription": "KonMin Launcher — Minecraft launcher",
    "longDescription": "KonMin Launcher is a Minecraft launcher: official Mojang versions, Fabric, Quilt, Forge and NeoForge loaders, mods and modpacks from Modrinth and CurseForge. A fork of the GPL-3.0 Millida Launcher project.",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "compression": {
          "type": "zstd",
          "level": 9
        }
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "languages": ["Russian", "English"]
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "konmin"
        ]
      }
    },
    "updater": {
      "endpoints": [],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
